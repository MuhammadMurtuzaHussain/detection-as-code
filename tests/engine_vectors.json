[
  {"name": "plain value is exact and case-insensitive", "detection": {"selection": {"Image": "C:\\Windows\\cmd.exe"}, "condition": "selection"}, "event": {"Image": "c:\\windows\\CMD.EXE"}, "match": true},
  {"name": "plain value is not a substring match", "detection": {"selection": {"Image": "C:\\Windows\\cmd.exe"}, "condition": "selection"}, "event": {"Image": "C:\\Windows\\cmd.exe.bak"}, "match": false},
  {"name": "contains hits", "detection": {"selection": {"CommandLine|contains": "EVIL"}, "condition": "selection"}, "event": {"CommandLine": "run evil now"}, "match": true},
  {"name": "contains misses", "detection": {"selection": {"CommandLine|contains": "good"}, "condition": "selection"}, "event": {"CommandLine": "run evil now"}, "match": false},
  {"name": "startswith hits", "detection": {"selection": {"Image|startswith": "c:\\tools"}, "condition": "selection"}, "event": {"Image": "C:\\Tools\\a.exe"}, "match": true},
  {"name": "startswith misses", "detection": {"selection": {"Image|startswith": "tools"}, "condition": "selection"}, "event": {"Image": "C:\\Tools\\a.exe"}, "match": false},
  {"name": "endswith hits", "detection": {"selection": {"Image|endswith": ".EXE"}, "condition": "selection"}, "event": {"Image": "C:\\Tools\\a.exe"}, "match": true},
  {"name": "endswith ignores a trailing newline", "detection": {"selection": {"Image|endswith": ".exe"}, "condition": "selection"}, "event": {"Image": "C:\\a.exe\n"}, "match": false},
  {"name": "value list is OR by default", "detection": {"selection": {"CommandLine|contains": ["nothing", "delete"]}, "condition": "selection"}, "event": {"CommandLine": "vssadmin delete shadows"}, "match": true},
  {"name": "all modifier requires every value", "detection": {"selection": {"CommandLine|contains|all": ["delete", "shadows"]}, "condition": "selection"}, "event": {"CommandLine": "vssadmin delete shadows"}, "match": true},
  {"name": "all modifier fails if one value is absent", "detection": {"selection": {"CommandLine|contains|all": ["delete", "nothing"]}, "condition": "selection"}, "event": {"CommandLine": "vssadmin delete shadows"}, "match": false},
  {"name": "backslash plus wildcard spans directories", "detection": {"selection": {"Image": "C:\\\\*\\cmd.exe"}, "condition": "selection"}, "event": {"Image": "C:\\Windows\\System32\\cmd.exe"}, "match": true},
  {"name": "escaped asterisk is literal, so it does not span directories", "detection": {"selection": {"Image": "C:\\*\\cmd.exe"}, "condition": "selection"}, "event": {"Image": "C:\\Windows\\System32\\cmd.exe"}, "match": false},
  {"name": "escaped asterisk matches a literal asterisk", "detection": {"selection": {"Image": "C:\\*\\cmd.exe"}, "condition": "selection"}, "event": {"Image": "C:*\\cmd.exe"}, "match": true},
  {"name": "question mark matches exactly one character", "detection": {"selection": {"Name": "a?c"}, "condition": "selection"}, "event": {"Name": "abbc"}, "match": false},
  {"name": "wildcard spans newlines", "detection": {"selection": {"Name|contains": "a*z"}, "condition": "selection"}, "event": {"Name": "a\nb\nz"}, "match": true},
  {"name": "regex is case-sensitive by default", "detection": {"selection": {"CommandLine|re": "powershell"}, "condition": "selection"}, "event": {"CommandLine": "PowerShell -ENC AAAA"}, "match": false},
  {"name": "regex i flag", "detection": {"selection": {"CommandLine|re|i": "powershell"}, "condition": "selection"}, "event": {"CommandLine": "PowerShell -ENC AAAA"}, "match": true},
  {"name": "regex inline (?i) at the start", "detection": {"selection": {"CommandLine|re": "(?i)powershell"}, "condition": "selection"}, "event": {"CommandLine": "PowerShell -ENC AAAA"}, "match": true},
  {"name": "regex is a search, not anchored", "detection": {"selection": {"CommandLine|re": "\\s-enc\\s"}, "condition": "selection"}, "event": {"CommandLine": "powershell -enc AAA"}, "match": true},
  {"name": "regex with $ matches only the true end of the string", "detection": {"selection": {"CommandLine|re": "enc$"}, "condition": "selection"}, "event": {"CommandLine": "x -enc"}, "match": true},
  {"name": "number matches the same number as text", "detection": {"selection": {"EventID": 1}, "condition": "selection"}, "event": {"EventID": "1"}, "match": true},
  {"name": "number matches a number", "detection": {"selection": {"EventID": 1}, "condition": "selection"}, "event": {"EventID": 1}, "match": true},
  {"name": "missing field does not match", "detection": {"selection": {"EventID": 1}, "condition": "selection"}, "event": {}, "match": false},
  {"name": "missing field does not match a modifier either", "detection": {"selection": {"Image|contains": "x"}, "condition": "selection"}, "event": {}, "match": false},
  {"name": "null matches a missing field", "detection": {"selection": {"ParentImage": null}, "condition": "selection"}, "event": {"Image": "x"}, "match": true},
  {"name": "null matches a null field", "detection": {"selection": {"ParentImage": null}, "condition": "selection"}, "event": {"ParentImage": null}, "match": true},
  {"name": "null does not match a present field", "detection": {"selection": {"ParentImage": null}, "condition": "selection"}, "event": {"ParentImage": "cmd.exe"}, "match": false},
  {"name": "dotted path reaches nested fields", "detection": {"selection": {"process.name": "cmd.exe"}, "condition": "selection"}, "event": {"process": {"name": "CMD.exe"}}, "match": true},
  {"name": "list-valued event field matches if any element does", "detection": {"selection": {"Tags|contains": "bad"}, "condition": "selection"}, "event": {"Tags": ["ok", "very-bad"]}, "match": true},
  {"name": "selection as a list of maps is OR", "detection": {"selection": [{"Image|endswith": "\\a.exe"}, {"Image|endswith": "\\b.exe"}], "condition": "selection"}, "event": {"Image": "C:\\b.exe"}, "match": true},
  {"name": "fields in one selection are ANDed", "detection": {"selection": {"Image|endswith": "\\a.exe", "User": "root"}, "condition": "selection"}, "event": {"Image": "C:\\a.exe", "User": "bob"}, "match": false},
  {"name": "and, not", "detection": {"sel_a": {"A": "1"}, "filter": {"F": "1"}, "condition": "sel_a and not filter"}, "event": {"A": "1"}, "match": true},
  {"name": "and, not filter present", "detection": {"sel_a": {"A": "1"}, "filter": {"F": "1"}, "condition": "sel_a and not filter"}, "event": {"A": "1", "F": "1"}, "match": false},
  {"name": "and binds tighter than or", "detection": {"sel_a": {"A": "1"}, "sel_b": {"B": "1"}, "filter": {"F": "1"}, "condition": "sel_b or sel_a and not filter"}, "event": {"A": "1"}, "match": true},
  {"name": "parentheses override precedence", "detection": {"sel_a": {"A": "1"}, "sel_b": {"B": "1"}, "filter": {"F": "1"}, "condition": "(sel_b or sel_a) and filter"}, "event": {"A": "1"}, "match": false},
  {"name": "keywords are case-insensitive", "detection": {"sel_a": {"A": "1"}, "sel_b": {"B": "1"}, "condition": "sel_a AND NOT sel_b"}, "event": {"A": "1"}, "match": true},
  {"name": "1 of pattern", "detection": {"sel_a": {"A": "1"}, "sel_b": {"B": "1"}, "condition": "1 of sel_*"}, "event": {"A": "1"}, "match": true},
  {"name": "all of pattern needs every selection", "detection": {"sel_a": {"A": "1"}, "sel_b": {"B": "1"}, "condition": "all of sel_*"}, "event": {"A": "1"}, "match": false},
  {"name": "all of pattern when all match", "detection": {"sel_a": {"A": "1"}, "sel_b": {"B": "1"}, "condition": "all of sel_*"}, "event": {"A": "1", "B": "1"}, "match": true},
  {"name": "1 of them", "detection": {"sel_a": {"A": "1"}, "other": {"B": "1"}, "condition": "1 of them"}, "event": {"B": "1"}, "match": true},
  {"name": "all of them", "detection": {"sel_a": {"A": "1"}, "other": {"B": "1"}, "condition": "all of them"}, "event": {"A": "1"}, "match": false},
  {"name": "quantifier combined with not", "detection": {"sel_a": {"A": "1"}, "sel_b": {"B": "1"}, "filter": {"F": "1"}, "condition": "1 of sel_* and not filter"}, "event": {"A": "1", "F": "1"}, "match": false},
  {"name": "condition list is OR", "detection": {"sel_a": {"A": "1"}, "sel_b": {"B": "1"}, "condition": ["sel_a", "sel_b"]}, "event": {"B": "1"}, "match": true},
  {"name": "selection names that look like object properties are safe", "detection": {"constructor": {"A": "1"}, "condition": "constructor"}, "event": {"A": "1"}, "match": true},

  {"name": "base64 modifier", "detection": {"selection": {"A|base64": "x"}, "condition": "selection"}, "error": "unsupported"},
  {"name": "windash modifier", "detection": {"selection": {"A|windash|contains": "x"}, "condition": "selection"}, "error": "unsupported"},
  {"name": "count aggregation", "detection": {"selection": {"A": "x"}, "condition": "selection | count() > 5"}, "error": "unsupported"},
  {"name": "timeframe", "detection": {"selection": {"A": "x"}, "condition": "selection", "timeframe": "5m"}, "error": "unsupported"},
  {"name": "keyword selection", "detection": {"keywords": ["mimikatz"], "condition": "keywords"}, "error": "unsupported"},
  {"name": "no condition", "detection": {"selection": {"A": "x"}}, "error": "malformed"},
  {"name": "no selections", "detection": {"condition": "selection"}, "error": "malformed"},
  {"name": "unknown selection in condition", "detection": {"selection": {"A": "x"}, "condition": "other"}, "error": "malformed"},
  {"name": "dangling operator", "detection": {"selection": {"A": "x"}, "condition": "selection and"}, "error": "malformed"},
  {"name": "unbalanced parenthesis", "detection": {"selection": {"A": "x"}, "condition": "(selection"}, "error": "malformed"},
  {"name": "pattern that matches nothing", "detection": {"selection": {"A": "x"}, "condition": "1 of nothing_*"}, "error": "malformed"},
  {"name": "empty selection would match everything", "detection": {"selection": {}, "condition": "selection"}, "error": "malformed"},
  {"name": "two match modifiers", "detection": {"selection": {"A|contains|startswith": "x"}, "condition": "selection"}, "error": "malformed"},
  {"name": "regex flag without re", "detection": {"selection": {"A|i": "x"}, "condition": "selection"}, "error": "malformed"},
  {"name": "invalid regular expression", "detection": {"selection": {"A|re": "("}, "condition": "selection"}, "error": "malformed"},
  {"name": "null with a modifier", "detection": {"selection": {"A|contains": null}, "condition": "selection"}, "error": "malformed"}
]
